# Connection settings for deploy.ps1 and push-assets.ps1
# Copy this file to .env and fill in your values.
#
# REMOTE_PATH points at the backend/public directory on the server
# (the SCP target for push-assets.ps1).
# REMOTE_DEPLOY_DIR is the repository root on the server, where
# deploy.sh lives (used by deploy.ps1).

REMOTE_USER=youruser
REMOTE_HOST=yourserver.com
REMOTE_PATH=/home/youruser/job-track/backend/public
REMOTE_DEPLOY_DIR=/home/youruser/job-track
REMOTE_PORT=22
