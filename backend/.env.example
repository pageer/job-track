# Copy this file to `.env.local` on the target server and fill in real values.
# See https://symfony.com/doc/current/configuration.html#configuration-based-on-environment-variables

APP_ENV=prod
APP_SECRET=change-me-to-a-long-random-string

# MySQL / MariaDB connection string for your shared hosting provider.
# Example: mysql://username:password@localhost:3306/yourdbname?serverVersion=8.0.32&charset=utf8mb4
# For MariaDB use e.g. serverVersion=10.6.18-MariaDB
DATABASE_URL="mysql://user:password@localhost:3306/dbname?serverVersion=8.0.32&charset=utf8mb4"
