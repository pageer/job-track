# Copy this file to `.env` for local development and adjust as needed
# (e.g. `copy .env.example .env` on Windows). The `.env` file is gitignored.
# For production, keep real values in `.env.local` (gitignored) — see deploy.sh.

###> symfony/framework-bundle ###
APP_ENV=dev
# Generate your own long random string; override in `.env.local` for production.
APP_SECRET=change-me-to-a-long-random-string
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Used to generate URLs in CLI contexts. Set in `.env.local` for production.
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Local dev default, matches the repo-root docker-compose.yml `db` service.
# For shared hosting, override in `.env.local` with your real credentials and
# update `serverVersion` to match your MySQL/MariaDB version.
DATABASE_URL="mysql://app:app@127.0.0.1:3307/job_track?serverVersion=8.4.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> phpunit ###
# `composer phpunit` sets APP_ENV=test and tests/bootstrap.php loads this `.env`;
# a `.env.test` file is optional. Defaults used by the test env:
# KERNEL_CLASS='App\Kernel'
# APP_SECRET='$ecretf0rt3st'
###< phpunit ###

###> openrouter ###
# Optional: powers the "Auto-fill from message" feature (OpenRouter API v1 chat completions).
# Put your real key in `.env.local`, not here. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model used for extraction; defaults to a free OpenRouter model. See https://openrouter.ai/models
OPENROUTER_MODEL=google/gemma-4-31b-it:free
###< openrouter ###

###> onedrive ###
# Microsoft app registration (personal accounts) for the "Pick from OneDrive" feature.
# Register at https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps:
#   - Supported account types: "Personal Microsoft accounts only"
#   - Redirect URIs (in addition to your production origin):
#       http://127.0.0.1:8000/api/onedrive/callback
#       http://localhost:5173/api/onedrive/callback   (Vite dev server)
#   - API permissions: Files.Read, offline_access (User.Read optional, for the display name)
# Then paste the Application (client) ID in `.env.local`.
ONEDRIVE_CLIENT_ID=
# Tenant used for sign-in. `consumers` = personal Microsoft accounts only.
ONEDRIVE_TENANT=consumers
# OneDrive folder whose contents are offered when picking a resume.
ONEDRIVE_FOLDER_PATH=Resumes
# Optional: full URL used as the OAuth redirect URI. Leave empty to auto-detect from the
# request host (must still match a registered redirect URI).
ONEDRIVE_REDIRECT_URI=
###< onedrive ###